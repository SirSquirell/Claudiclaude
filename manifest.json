{
  "manifest_version": 3,
  "name": "Asteria",
  "version": "0.70.0",
  "description": "Asteria reconstructs your DEGIRO portfolio value over time from the session your browser already holds. Personal use only.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://trader.degiro.nl/*",
    "https://charting.vwdservices.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://trader.degiro.nl/*"],
      "js": ["src/content/boot.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://asteria.prulwerk.nl/*"],
      "js": ["src/content/site.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/banner.js",
        "src/lib/bannermodel.js",
        "src/content/readywatch.js",
        "src/lib/readiness.js"
      ],
      "matches": ["https://trader.degiro.nl/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Asteria",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/ui/app.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
