{
  "manifest_version": 3,
  "name": "DEGIRO Portfolio History",
  "version": "0.28.0",
  "description": "Reconstructs your DEGIRO portfolio value over time. Personal use only.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "alarms", "cookies"],
  "host_permissions": [
    "https://trader.degiro.nl/*",
    "https://charting.vwdservices.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "DEGIRO Portfolio History",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/ui/app.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
